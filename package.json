{
  "name": "lucky-draw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "럭키드로우 경품 추첨 원판 — 클라이언트 전용 SPA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:css && npm run lint:slop",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:slop": "node tools/anti-slop-lint.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "stylelint": "^16.10.0",
    "typescript": "~5.6.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0"
  }
}
